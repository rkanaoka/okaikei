{
  "name": "okaikei",
  "version": "1.0.0",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rkanaoka/okaikei.git"
  },
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/rkanaoka/okaikei/issues"
  },
  "homepage": "https://github.com/rkanaoka/okaikei#readme",
  "description": "",
  "scripts": {
    "dev": "npm run services:up && npm run wait-for-postgres && npm run migration:up && next dev",
    "services:up": "docker compose -f infra/compose.yaml up -d",
    "services:stop": "docker compose -f infra/compose.yaml stop",
    "services:down": "docker compose -f infra/compose.yaml down",
    "services:reset": "npm run services:down && npm run dev",
    "psql": "psql -h localhost -d bodogami_local -p 5432 -U bodogami",
    "lint:prettier:check": "prettier --check .",
    "lint:prettier:fix": "prettier --write .",
    "test": "npm run services:up && concurrently -n next,jest --hide next -k -s command-jest \"next dev\" \"jest --runInBand --verbose\"",
    "test:watch": "jest --runInBand --watchAll",
    "migration:create": "node-pg-migrate -m infra/migrations create",
    "migration:up": "node-pg-migrate -m infra/migrations --envPath .env.development up",
    "migration:down": "node-pg-migrate down -m infra/migrations",
    "wait-for-postgres": "node infra/scripts/wait-for-postgres.cjs",
    "build": "next build",
    "start": "next start"
  },
  "dependencies": {
    "async-retry": "^1.3.3",
    "chart.js": "^4.5.1",
    "dotenv": "^17.3.1",
    "dotenv-expand": "^12.0.3",
    "express": "^5.2.1",
    "fs": "^0.0.1-security",
    "make": "^0.0.0",
    "next": "^16.1.6",
    "node-pg-migrate": "^6.2.2",
    "nodemailer": "^9.0.5",
    "pg": "^8.18.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "swr": "^2.4.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "jest": "^29.6.2",
    "prettier": "^3.8.1"
  }
}
