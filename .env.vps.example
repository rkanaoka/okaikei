# ─── Bodogami VPS — Variáveis de Ambiente ─────────────────────────────────────
# Copie para .env.vps e preencha os valores reais.
# NUNCA comite o .env.vps no git.
#
# Deploy:
#   docker compose -f docker-compose.hostinger.yml --env-file .env.vps up -d --build
# ─────────────────────────────────────────────────────────────────────────────

# ── Domínio ───────────────────────────────────────────────────────────────────
CARDAPIO_DOMAIN=cardapio.bodogami.tech

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=troque_por_senha_forte_aqui

# ── Conexão WireGuard → Backend local ────────────────────────────────────────
# IP WireGuard do servidor local do restaurante
LOCAL_BACKEND_URL=http://10.0.0.1:3000

# Chave compartilhada (deve ser a mesma que LOCAL_API_KEY no .env.development)
LOCAL_API_KEY=troque_por_chave_super_secreta_512bits

# ── Cache ─────────────────────────────────────────────────────────────────────
CACHE_TTL_SECONDS=300

# ── WireGuard CIDR (IPs permitidos para /internal/*) ─────────────────────────
# Range da sua rede WireGuard privada
WIREGUARD_CIDR=10.0.0.0/8
