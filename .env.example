# ─── Bodogami — Variáveis de Ambiente ────────────────────────────────────────
# Copie para .env e ajuste os valores

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=bodogami
POSTGRES_PASSWORD=bodogami_secret
POSTGRES_DB=bodogami_local

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=redis_secret

# ── NATS ──────────────────────────────────────────────────────────────────────
NATS_TOKEN=nats_secret

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=TROQUE_ISSO_EM_PRODUCAO_32_CHARS_MINIMO

# ── Nuvem (opcional — sincronização e backup) ─────────────────────────────────
# Deixar em branco desativa a sincronização sem quebrar o sistema local
CLOUD_API_URL=https://cloud.bodogami.com.br/sync
CLOUD_API_KEY=

# URL para enviar backups pg_dump (S3, R2, etc.) — opcional
CLOUD_BACKUP_URL=

# ── Impressoras ESC/POS (IPs fixos na LAN) ────────────────────────────────────
# Configuráveis também via painel admin em runtime
PRINTER_COZINHA_IP=192.168.1.201
PRINTER_BAR_IP=192.168.1.202
PRINTER_CAIXA_IP=192.168.1.203
PRINTER_PORT=9100
