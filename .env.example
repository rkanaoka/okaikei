# ─── Bodogami — Variáveis de Ambiente ────────────────────────────────────────
# Copie para .env e ajuste os valores

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=bodogami
POSTGRES_PASSWORD=bodogami_secret
POSTGRES_DB=bodogami_local

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=redis_secret

# ── NATS ──────────────────────────────────────────────────────────────────────
NATS_TOKEN=nats_secret

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=TROQUE_ISSO_EM_PRODUCAO_32_CHARS_MINIMO
JWT_EXPIRES_IN=12h

# ── Admin (login usuário/senha do painel) ─────────────────────────────────────
# Usuário mestre fixo "admin" — senha definida só aqui, nunca no banco
ADMIN_PASSWORD=troque_esta_senha

# ── Firebase (login Google no painel Admin) ───────────────────────────────────
# Backend (Admin SDK — Project Settings > Service Accounts > Generate new private key)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Frontend (Web App config — Project Settings > General > Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# ── Nuvem (opcional — sincronização e backup) ─────────────────────────────────
# Deixar em branco desativa a sincronização sem quebrar o sistema local
CLOUD_API_URL=https://cloud.bodogami.com.br/sync
CLOUD_API_KEY=

# URL para enviar backups pg_dump (S3, R2, etc.) — opcional
CLOUD_BACKUP_URL=

# ── Impressoras ESC/POS (IPs fixos na LAN) ────────────────────────────────────
# Configuráveis também via painel admin em runtime
PRINTER_COZINHA_IP=192.168.1.201
PRINTER_BAR_IP=192.168.1.202
PRINTER_CAIXA_IP=192.168.1.203
PRINTER_PORT=9100

# ── Impressora de etiquetas ZPL (Elgin L42 Pro Full) ─────────────────────────
LABEL_PRINTER_TYPE=ethernet
LABEL_PRINTER_HOST=192.168.1.210
LABEL_PRINTER_PORT=9100
# LABEL_PRINTER_TYPE=usb
# LABEL_PRINTER_USB_PATH=/dev/usb/lp0
LABEL_PRINTER_TIMEOUT_MS=5000

# ── Cardápio Digital (integração VPS → local via WireGuard) ──────────────────
# Chave compartilhada entre VPS e backend local
LOCAL_API_KEY=troque_por_chave_super_secreta_512bits
