// ─── Bodogami — Prisma Schema ─────────────────────────────────────────────────
// Local-First POS • UUID v7 como PK (gerado na camada de aplicação)

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Usuários / Operadores ────────────────────────────────────────────────────
model User {
  id        String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  name      String   @db.VarChar(100)
  email     String   @unique @db.VarChar(200)
  password  String
  role      UserRole @default(WAITER)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  comandas Comanda[]

  @@map("users")
}

enum UserRole {
  ADMIN
  CASHIER
  WAITER
  KITCHEN
}

// ─── Categorias do Cardápio (organização/exibição) ────────────────────────────
model MenuCategory {
  id        String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  name      String   @db.VarChar(60)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  items MenuItem[]

  @@map("menu_categories")
}

// ─── Itens do Cardápio ────────────────────────────────────────────────────────
model MenuItem {
  id          String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  name        String   @db.VarChar(120)
  description String?
  price       Decimal  @db.Decimal(10, 2)
  // 'kitchen' | 'bar' | 'cashier' — categoria legada de impressão (fallback se printCategories vier vazio)
  category        String   @db.VarChar(30)
  subcategory     String?  @db.VarChar(60)
  categoryId      String?  @map("category_id") @db.Uuid
  printCategories String[] @default([]) @map("print_categories") // impressoras de destino: kitchen | bar | cashier (permite mais de uma)
  imageUrl    String?  @map("image_url")
  available   Boolean  @default(true)
  sortOrder   Int      @default(0) @map("sort_order")
  // Se falso, o valor do item não entra na base de cálculo da taxa de serviço (gorjeta compulsória)
  chargeServiceFee     Boolean @default(true) @map("charge_service_fee")
  // { enabled, days:[0-6] (0=domingo), startTime:"HH:mm", endTime:"HH:mm" } — null/enabled=false = sempre disponível
  availabilitySchedule Json?   @map("availability_schedule")
  // ids de OptionGroup, na ordem de exibição escolhida para este item (a vinculação em si é o relation abaixo)
  optionGroupOrder String[] @default([]) @map("option_group_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  menuCategory MenuCategory?  @relation(fields: [categoryId], references: [id])
  comandaItems ComandaItem[]
  optionGroups OptionGroup[]  @relation("MenuItemOptionGroups")

  @@index([category])
  @@index([available])
  @@index([categoryId])
  @@map("menu_items")
}

// ─── Grupos de Opções (personalização de itens, ex: "Escolha o sabor") ────────
model OptionGroup {
  id        String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  name      String   @db.VarChar(150)
  minSelect Int      @default(0) @map("min_select")
  maxSelect Int      @default(1) @map("max_select")
  active    Boolean  @default(true)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  options   MenuOption[]
  menuItems MenuItem[]   @relation("MenuItemOptionGroups")

  @@map("option_groups")
}

model MenuOption {
  id        String  @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  groupId   String  @map("group_id") @db.Uuid
  name      String  @db.VarChar(120)
  price     Decimal @default(0) @db.Decimal(10, 2)
  active    Boolean @default(true)
  sortOrder Int     @default(0) @map("sort_order")

  group OptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@map("menu_options")
}

// ─── Mesas ────────────────────────────────────────────────────────────────────
model Table {
  id        String      @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  number    Int         @unique
  label     String      @db.VarChar(50)   // ex: "Mesa 5", "Balcão"
  capacity  Int         @default(4)
  status    TableStatus @default(FREE)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  comandas Comanda[]

  @@map("tables")
}

enum TableStatus {
  FREE
  OCCUPIED
  RESERVED
}

// ─── Comandas ─────────────────────────────────────────────────────────────────
model Comanda {
  id           String        @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  number       Int           @default(autoincrement())   // número legível (ex: #42)
  tableId      String?       @map("table_id") @db.Uuid
  customerName String?       @map("customer_name") @db.VarChar(100)
  userId       String?       @map("user_id") @db.Uuid   // garçom responsável
  status       ComandaStatus @default(OPEN)
  notes        String?

  // Ajustes de fechamento
  surchargeType  String?  @map("surcharge_type") @db.VarChar(10) // 'percent' | 'fixed'
  surchargeValue Decimal? @default(0) @map("surcharge_value") @db.Decimal(10, 2)
  discountType   String?  @map("discount_type") @db.VarChar(10)
  discountValue  Decimal? @default(0) @map("discount_value") @db.Decimal(10, 2)

  openedAt  DateTime  @default(now()) @map("opened_at")
  closedAt  DateTime? @map("closed_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  table        Table?        @relation(fields: [tableId], references: [id])
  user         User?         @relation(fields: [userId], references: [id])
  items        ComandaItem[]
  payments     Payment[]

  @@index([status])
  @@index([openedAt])
  @@map("comandas")
}

enum ComandaStatus {
  OPEN
  PREPARING
  CLOSED
  CANCELLED
}

// ─── Itens de Comanda ─────────────────────────────────────────────────────────
model ComandaItem {
  id         String          @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  comandaId  String          @map("comanda_id") @db.Uuid
  menuItemId String          @map("menu_item_id") @db.Uuid
  quantity   Int             @default(1)
  unitPrice  Decimal         @map("unit_price") @db.Decimal(10, 2) // snapshot do preço
  notes      String?         @db.VarChar(300)
  status     OrderItemStatus @default(PENDING)
  sentAt     DateTime?       @map("sent_at")
  createdAt  DateTime        @default(now()) @map("created_at")

  comanda  Comanda  @relation(fields: [comandaId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])

  @@index([comandaId])
  @@index([status])
  @@map("comanda_items")
}

enum OrderItemStatus {
  PENDING
  SENT
  PREPARING
  READY
  DELIVERED
  CANCELLED
}

// ─── Pagamentos ───────────────────────────────────────────────────────────────
model Payment {
  id            String        @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  comandaId     String        @map("comanda_id") @db.Uuid
  method        PaymentMethod
  amount        Decimal       @db.Decimal(10, 2)
  notes         String?       @db.VarChar(200)
  paidAt        DateTime      @default(now()) @map("paid_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  cashSessionId String?       @map("cash_session_id") @db.Uuid

  comanda     Comanda      @relation(fields: [comandaId], references: [id], onDelete: Cascade)
  cashSession CashSession? @relation(fields: [cashSessionId], references: [id])

  @@index([comandaId])
  @@index([cashSessionId])
  @@map("payments")
}

enum PaymentMethod {
  CASH
  CARD
  PIX
  VOUCHER
}

// ─── Motivos de Cancelamento ──────────────────────────────────────────────────
model CancellationReason {
  id        String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  label     String   @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")

  cancellations Cancellation[]

  @@map("cancellation_reasons")
}

// Log de itens cancelados — preserva o item mesmo após a remoção do comanda_items
model Cancellation {
  id        String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  reasonId  String   @map("reason_id") @db.Uuid
  comandaId String?  @map("comanda_id") @db.Uuid
  itemName  String   @map("item_name") @db.VarChar(120)
  quantity  Int      @default(1)
  amount    Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now()) @map("created_at")

  reason CancellationReason @relation(fields: [reasonId], references: [id])

  @@index([reasonId])
  @@map("cancellations")
}

// ─── Motivos de Desconto ──────────────────────────────────────────────────────
model DiscountReason {
  id        String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  label     String   @db.VarChar(100)
  type      String   @db.VarChar(10) // 'percent' | 'fixed'
  value     Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("discount_reasons")
}

// ─── Vouchers (Cupons de Desconto) ─────────────────────────────────────────────
model Voucher {
  id                   String        @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  code                 String        @unique @db.VarChar(12)
  confirmationPassword String        @map("confirmation_password") @db.VarChar(6)
  customerName         String        @map("customer_name") @db.VarChar(100)
  customerCpf          String        @map("customer_cpf") @db.VarChar(14)
  customerBirthDate    DateTime      @map("customer_birth_date") @db.Date
  customerAddress      String        @map("customer_address") @db.VarChar(200)
  customerPhone        String        @map("customer_phone") @db.VarChar(20)
  customerEmail        String        @map("customer_email") @db.VarChar(200)
  amount               Decimal       @db.Decimal(10, 2)
  status               VoucherStatus @default(NEGOTIATION)
  dueDate              DateTime      @map("due_date") @db.Date
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  @@map("vouchers")
}

enum VoucherStatus {
  NEGOTIATION
  PAID
  USED
  CANCELLED
  EXPIRED
}

// ─── Modelos de Impressão ─────────────────────────────────────────────────────
model PrintTemplate {
  id        String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  type      String   @unique @db.VarChar(20) // 'kitchen' | 'bar' | 'receipt' | 'fiscal'
  enabled   Boolean  @default(true)
  config    Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("print_templates")
}

// ─── Frente de Caixa ──────────────────────────────────────────────────────────
model CashSession {
  id            String            @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  openingAmount Decimal           @default(0) @map("opening_amount") @db.Decimal(10, 2)
  openingNotes  String?           @map("opening_notes")
  closingNotes  String?           @map("closing_notes")
  closingCounts Json?             @map("closing_counts") // snapshot {method: valorEmCaixa} no fechamento
  status        CashSessionStatus @default(OPEN)
  openedAt      DateTime          @default(now()) @map("opened_at")
  closedAt      DateTime?         @map("closed_at")

  movements CashMovement[]
  payments  Payment[]

  @@index([status])
  @@map("cash_sessions")
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

// ─── Movimentações de Caixa (Retirada / Reforço) ─────────────────────────────
model CashMovement {
  id            String           @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  cashSessionId String           @map("cash_session_id") @db.Uuid
  type          CashMovementType
  amount        Decimal          @db.Decimal(10, 2)
  notes         String?
  createdAt     DateTime         @default(now()) @map("created_at")

  cashSession CashSession @relation(fields: [cashSessionId], references: [id], onDelete: Cascade)

  @@index([cashSessionId])
  @@map("cash_movements")
}

enum CashMovementType {
  WITHDRAWAL
  REINFORCEMENT
}

// ─── Impressoras ──────────────────────────────────────────────────────────────
model Printer {
  id        String  @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  category  String  @unique @db.VarChar(30) // 'kitchen' | 'bar' | 'cashier'
  ip        String  @db.VarChar(45)
  port      Int     @default(9100)
  label     String? @db.VarChar(60)
  enabled   Boolean @default(true)

  @@map("printers")
}

// ─── Fila de Sincronização ───────────────────────────────────────────────────
// Persiste todos os eventos para envio assíncrono à nuvem.
// NUNCA bloqueia a operação do sistema.
model SyncQueue {
  id           String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  eventType    String    @map("event_type") @db.VarChar(100) // ex: 'comanda.created'
  entityType   String    @map("entity_type") @db.VarChar(50) // ex: 'Comanda'
  entityId     String    @map("entity_id") @db.Uuid
  payload      Json
  status       SyncStatus @default(PENDING)
  attempts     Int       @default(0)
  lastAttempt  DateTime? @map("last_attempt")
  nextRetry    DateTime? @map("next_retry")
  errorMessage String?   @map("error_message") @db.Text
  syncedAt     DateTime? @map("synced_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([status])
  @@index([nextRetry])
  @@index([entityType, entityId])
  @@map("sync_queue")
}

enum SyncStatus {
  PENDING
  IN_PROGRESS
  SYNCED
  FAILED
  SKIPPED
}

// ─── Configurações do Sistema ─────────────────────────────────────────────────
model SystemConfig {
  key       String   @id @db.VarChar(100)
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_config")
}
