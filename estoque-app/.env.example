# Copie para .env.local (dev) ou defina no .env.vps da VPS (produção).
# NUNCA comite o .env.local / .env.vps no git.

# ── Autenticação da tela de login ─────────────────────────────────────────────
ESTOQUE_PASSWORD=troque_por_senha_forte_aqui
# Segredo usado para assinar o cookie de sessão (HMAC) — qualquer string longa e aleatória
ESTOQUE_SESSION_SECRET=troque_por_chave_super_secreta_512bits

# ── Conexão com o okaikei server via WireGuard ────────────────────────────────
# Mesmo IP/porta e mesma chave já usados pelo vps-api (ver .env.vps.example na raiz)
OKAIKEI_BACKEND_URL=http://10.0.0.1:3000
OKAIKEI_API_KEY=troque_por_chave_super_secreta_512bits
